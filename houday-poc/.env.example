# Supabase のプロジェクト設定 > API から取得（東京リージョンで作成すること）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key（旧 anon key でも可）。service_role / secret key は絶対に入れない
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# 共有リンクやログインメールに使う公開URL（ローカルでは http://localhost:3000）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
